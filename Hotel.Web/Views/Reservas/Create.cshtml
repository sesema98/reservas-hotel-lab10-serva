@model Reserva
@{ ViewData["Title"] = "Nueva reserva"; }
<h1>Nueva reserva</h1><p>La reserva se registrará con estado Pendiente.</p>
<form asp-action="Create" method="post" class="formulario">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="IdHuesped" class="form-label">Huésped</label><select asp-for="IdHuesped" asp-items="ViewBag.Huespedes" class="form-select" required><option value="">Selecciona un huésped</option></select><span asp-validation-for="IdHuesped" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="IdHabitacion" class="form-label">Habitación</label><select asp-for="IdHabitacion" asp-items="ViewBag.Habitaciones" class="form-select" required><option value="">Selecciona una habitación</option></select><span asp-validation-for="IdHabitacion" class="text-danger"></span></div>
<div class="row"><div class="col-sm-6 mb-3"><label asp-for="FechaIngreso" class="form-label">Ingreso</label><input asp-for="FechaIngreso" type="date" class="form-control" required/><span asp-validation-for="FechaIngreso" class="text-danger"></span></div><div class="col-sm-6 mb-3"><label asp-for="FechaSalida" class="form-label">Salida</label><input asp-for="FechaSalida" type="date" class="form-control" required/><span asp-validation-for="FechaSalida" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="Observaciones" class="form-label">Observaciones</label><textarea asp-for="Observaciones" class="form-control" maxlength="200" rows="3"></textarea><span asp-validation-for="Observaciones" class="text-danger"></span><div class="form-text">Opcional. Máximo 200 caracteres.</div></div>
<button class="btn btn-primary">Guardar reserva</button> <a class="btn btn-outline-secondary" asp-action="Index">Volver</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
